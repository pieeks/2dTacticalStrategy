# Moderate gdtoolkit rules — keep CI green without a large style rewrite.
class-definitions-order: null
class-variable-order: null
max-line-length: 120
max-public-methods: null
max-returns: null
function-arguments-variable-snake-case: null
function-name: null
class-name: null
class-variable-name: null
signal-name: null
constant-name: null
variable-name: null
enum-name: null
enum-element-name: null
function-preload-variable-name: null
function-argument-name: null
loop-variable-name: null
unused-argument: null
no-else-return: null
duplicated-load: null
expression-not-assigned: null
unnecessary-pass: null
unused-variable: null
max-file-lines: null
max-function-arguments: null
max-function-lines: null
max-parameters-per-line: null
max-nested-levels: null
max-consecutive-empty-lines: 3
max-empty-lines: null
max-locals: null
max-class-method-lines: null
comparison-with-itself: error
no-elif-return: null
excluded_directories:
  - .git
  - .godot
  - addons
  - _dev
