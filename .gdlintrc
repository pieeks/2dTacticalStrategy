# Moderate gdtoolkit config — disable noisy style rules; keep CI stable.
# Use `disabled:` (not null thresholds) to avoid gdlint TypeErrors.

disabled:
  - class-definitions-order
  - class-variable-order
  - max-public-methods
  - max-returns
  - function-arguments-variable-snake-case
  - function-name
  - class-name
  - class-variable-name
  - signal-name
  - constant-name
  - variable-name
  - enum-name
  - enum-element-name
  - function-preload-variable-name
  - function-argument-name
  - loop-variable-name
  - unused-argument
  - no-else-return
  - no-elif-return
  - duplicated-load
  - expression-not-assigned
  - unnecessary-pass
  - unused-variable
  - max-file-lines
  - max-function-arguments
  - max-function-lines
  - max-parameters-per-line
  - max-nested-levels
  - max-empty-lines
  - max-locals
  - max-class-method-lines

max-line-length: 120
max-consecutive-empty-lines: 3

excluded_directories:
  - .git
  - .godot
  - addons
  - _dev
